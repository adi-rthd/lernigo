rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsLernigoRecord(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isLernigoLevel(level) {
      return level in ['A1', 'A2', 'B1', 'B2', 'C1'];
    }

    function validIdentity(profile) {
      let fields = ['firstName', 'lastName', 'username'];
      return !profile.keys().hasAny(fields)
        || (profile.keys().hasAll(fields)
          && profile.firstName is string && profile.firstName.size() >= 1 && profile.firstName.size() <= 60
          && profile.lastName is string && profile.lastName.size() >= 1 && profile.lastName.size() <= 60
          && profile.username is string && profile.username.matches('^[a-z0-9_]{3,24}$'));
    }

    match /wortdeckUsers/{uid} {
      allow read: if ownsLernigoRecord(uid);
      allow create, update: if ownsLernigoRecord(uid)
        && request.resource.data.keys().hasOnly(['level', 'listed', 'alias', 'firstName', 'lastName', 'username'])
        && validIdentity(request.resource.data)
        && isLernigoLevel(request.resource.data.level)
        && request.resource.data.listed is bool
        && request.resource.data.alias is string
        && (request.resource.data.listed
          ? request.resource.data.alias.size() >= 2 && request.resource.data.alias.size() <= 30
          : request.resource.data.alias == '');

      match /cards/{cardId} {
        function validCard() {
          let card = request.resource.data;
          return cardId.matches('^[0-9a-f]{16}$')
            && card.keys().hasAll(['right', 'wrong', 'last', 'updatedAt'])
            && card.keys().hasOnly(['right', 'wrong', 'last', 'updatedAt'])
            && card.right is int && card.right >= 0
            && card.wrong is int && card.wrong >= 0
            && card.last in ['right', 'wrong']
            && card.updatedAt == request.time;
        }
        function advancesFrom(right, wrong) {
          let card = request.resource.data;
          return (card.last == 'right' && card.right == right + 1 && card.wrong == wrong)
            || (card.last == 'wrong' && card.right == right && card.wrong == wrong + 1);
        }
        allow read: if ownsLernigoRecord(uid);
        allow create: if ownsLernigoRecord(uid) && validCard() && advancesFrom(0, 0);
        allow update: if ownsLernigoRecord(uid) && validCard()
          && advancesFrom(resource.data.right, resource.data.wrong);
      }

      match /quizSolved/{cardId} {
        function markedAnswer() {
          let card = getAfter(/databases/$(database)/documents/wortdeckUsers/$(uid)/cards/$(cardId)).data;
          let level = request.resource.data.level;
          return card.last == 'right' && card.updatedAt == request.time
            && getAfter(/databases/$(database)/documents/wortdeckUsers/$(uid)/scores/$(level)).data.cardId == cardId;
        }
        allow read: if ownsLernigoRecord(uid);
        allow create: if ownsLernigoRecord(uid)
          && cardId.matches('^[0-9a-f]{16}$')
          && request.resource.data.keys().hasOnly(['level'])
          && isLernigoLevel(request.resource.data.level)
          && markedAnswer();
      }

      match /scores/{level} {
        function newPoint(previous) {
          let score = request.resource.data;
          let cardId = score.cardId;
          let marker = /databases/$(database)/documents/wortdeckUsers/$(uid)/quizSolved/$(cardId);
          return isLernigoLevel(level) && score.keys().hasOnly(['points', 'cardId'])
            && score.points is int && score.points == previous + 1
            && score.points <= (level == 'A1' ? 793 : 12)
            && cardId is string && cardId.matches('^[0-9a-f]{16}$')
            && !exists(marker) && getAfter(marker).data.level == level;
        }
        allow read: if ownsLernigoRecord(uid);
        allow create: if ownsLernigoRecord(uid) && newPoint(0);
        allow update: if ownsLernigoRecord(uid) && newPoint(resource.data.points);
      }
    }

    match /lernigoHostedRooms/{uid} {
      function ownsLinkedRoom(link) {
        let room = /databases/$(database)/documents/lernigoGameRooms/$(link.code);
        return link.keys().hasOnly(['code'])
          && link.code is string && link.code.matches('^[2-9A-HJ-NP-Z]{6}$')
          && getAfter(room).data.host == uid;
      }

      function canReplaceRoom(previous, next) {
        let oldRoom = /databases/$(database)/documents/lernigoGameRooms/$(previous.code);
        let newRoom = /databases/$(database)/documents/lernigoGameRooms/$(next.code);
        return next.code != previous.code && (!exists(oldRoom) || get(oldRoom).data.phase == 'finished')
          && !exists(newRoom) && ownsLinkedRoom(next);
      }

      allow get: if ownsLernigoRecord(uid);
      allow create: if ownsLernigoRecord(uid) && ownsLinkedRoom(request.resource.data);
      allow update: if ownsLernigoRecord(uid) && canReplaceRoom(resource.data, request.resource.data);
    }

    match /lernigoGameRooms/{code} {
      function signedIn() {
        return request.auth != null;
      }

      function member(room) {
        return signedIn() && (room.host == request.auth.uid || request.auth.uid in room.players);
      }

      function host(room) {
        return signedIn() && room.host == request.auth.uid;
      }

      function roomPath() {
        return /databases/$(database)/documents/lernigoGameRooms/$(code);
      }

      function linkedRoom() {
        let uid = request.auth.uid;
        return getAfter(/databases/$(database)/documents/lernigoHostedRooms/$(uid)).data.code == code;
      }

      function roundOffset(room) {
        return room.get('gameNumber', 0) * 20;
      }

      function deadline(room) {
        return room.startedAt + duration.value(room.seconds, 's');
      }

      function validSettings(room) {
        return room.type in ['mixed', 'articles', 'nouns', 'verbs']
          && room.seconds is int && room.seconds >= 5 && room.seconds <= 60
          && room.get('level', 'A1') == 'A1'
          && room.get('chapter', 0) is int && room.get('chapter', 0) >= 0 && room.get('chapter', 0) <= 12
          && room.get('totalRounds', 10) is int
          && room.get('totalRounds', 10) >= 1 && room.get('totalRounds', 10) <= 20;
      }

      function validNewRoom(room) {
        return signedIn() && room.host == request.auth.uid
          && room.keys().hasOnly(['code', 'host', 'type', 'seconds', 'level', 'chapter', 'totalRounds', 'players', 'phase', 'round', 'createdAt', 'startedAt'])
          && code.matches('^[2-9A-HJ-NP-Z]{6}$') && room.code == code
          && validSettings(room)
          && room.players is map && room.players.size() == 0
          && room.phase == 'lobby' && room.round == 0
          && room.createdAt == request.time && room.startedAt == null;
      }

      function updatePlayers(previous, next) {
        let uid = request.auth.uid;
        let name = next.players.get(uid, '');
        return !host(previous) && next.players is map
          && next.diff(previous).affectedKeys().hasOnly(['players'])
          && next.players.diff(previous.players).affectedKeys().hasOnly([uid])
          && ((previous.phase == 'lobby' && !(uid in previous.players) && uid in next.players && next.players.size() <= 10
              && name is string && name.size() >= 1 && name.size() <= 24)
            || (uid in previous.players && !(uid in next.players)));
      }

      function updateSettings(previous, next) {
        return host(previous) && previous.phase == 'lobby'
          && next.diff(previous).affectedKeys().hasOnly(['type', 'seconds', 'level', 'chapter', 'totalRounds'])
          && validSettings(next);
      }

      function startRound(previous, next) {
        let id = string(roundOffset(previous) + next.round);
        let roundPath = /databases/$(database)/documents/lernigoGameRooms/$(code)/rounds/$(id);
        return host(previous) && (previous.phase == 'results'
            || (previous.phase == 'lobby' && previous.players.size() > 0))
          && next.diff(previous).affectedKeys().hasOnly(['phase', 'round', 'startedAt'])
          && next.phase == 'playing' && next.round == previous.round + 1 && next.round <= previous.get('totalRounds', 10)
          && next.startedAt == request.time && !exists(roundPath)
          && getAfter(roundPath).data.startedAt == request.time;
      }

      function revealRound(previous, next) {
        return member(previous) && previous.phase == 'playing' && request.time >= deadline(previous)
          && next.diff(previous).affectedKeys().hasOnly(['phase'])
          && next.phase == (previous.round == previous.get('totalRounds', 10) ? 'finished' : 'results');
      }

      allow get: if signedIn() && (resource == null || resource.data.phase == 'lobby' || member(resource.data));
      allow list: if host(resource.data);
      allow create: if validNewRoom(request.resource.data) && linkedRoom();
      allow update: if signedIn() && (updatePlayers(resource.data, request.resource.data)
        || updateSettings(resource.data, request.resource.data)
        || startRound(resource.data, request.resource.data) || revealRound(resource.data, request.resource.data));

      match /rounds/{roundId} {
        allow read: if member(get(roomPath()).data);
        allow create: if host(get(roomPath()).data)
          && roundId.matches('^[1-9][0-9]*$')
          && request.resource.data.keys().hasOnly(['cardId', 'startedAt'])
          && request.resource.data.cardId is string && request.resource.data.cardId.matches('^[0-9a-f]{16}$')
          && request.resource.data.startedAt == request.time
          && getAfter(roomPath()).data.phase == 'playing'
          && getAfter(roomPath()).data.round + roundOffset(getAfter(roomPath()).data) == int(roundId)
          && getAfter(roomPath()).data.startedAt == request.time;

        match /guesses/{uid} {
          function guessesRevealed(room) {
            let round = int(roundId) - roundOffset(room);
            return member(room) && round > 0 && (round < room.round
              || (round == room.round && room.phase in ['results', 'finished']));
          }

          function canGuess(room) {
            let guess = request.resource.data;
            return ownsLernigoRecord(uid) && member(room)
              && room.phase == 'playing' && int(roundId) == roundOffset(room) + room.round
              && roundId == string(roundOffset(room) + room.round) && request.time < deadline(room)
              && guess.keys().hasOnly(['answer', 'submittedAt'])
              && guess.answer is string && guess.answer.size() >= 1 && guess.answer.size() <= 120
              && guess.submittedAt == request.time;
          }

          allow get: if (ownsLernigoRecord(uid) && member(get(roomPath()).data)) || guessesRevealed(get(roomPath()).data);
          allow list: if guessesRevealed(get(roomPath()).data);
          allow create: if canGuess(get(roomPath()).data);
        }
      }
    }

    match /lernigoLeaderboards/{level}/entries/{uid} {
      function matchesScoreAndProfile() {
        let profile = getAfter(/databases/$(database)/documents/wortdeckUsers/$(uid)).data;
        let score = getAfter(/databases/$(database)/documents/wortdeckUsers/$(uid)/scores/$(level)).data;
        let entry = request.resource.data;
        return profile.listed == true && entry.keys().hasOnly(['alias', 'points'])
          && entry.alias == profile.alias && entry.points == score.points;
      }
      allow create, update: if ownsLernigoRecord(uid) && isLernigoLevel(level) && matchesScoreAndProfile();
      allow delete: if ownsLernigoRecord(uid) && isLernigoLevel(level);
    }
  }
}
